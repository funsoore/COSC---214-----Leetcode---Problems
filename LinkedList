public class Solution {
    public boolean hasCycle(ListNode head) {
        ListNode slow = head;
        ListNode fast = head;

        while(fast != null && fast.next != null) {
// advancing 1 node per step
slow = slow.next;
// advancing 2 node per step
fast = fast.next.next;
if (slow == fast)
return true;
}
return false;
}
    }
